[Unit]
Description=RPi Master Relay Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/wifi-fallback-relay
EnvironmentFile=-/etc/wifi-fallback-relay/config.env
ExecStart=/opt/wifi-fallback-relay/.venv/bin/python -m src.master_relay
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
