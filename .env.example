# Shared
LOG_LEVEL=INFO
DISCOVERY_SHARED_KEY=

# Master relay settings
MASTER_ID=rpi-master-01
CLOUD_ENDPOINT=wss://api.cornellhyperloop.com/hub
DISCOVERY_BIND_HOST=0.0.0.0
DISCOVERY_PORT=5319
RELAY_BIND_HOST=0.0.0.0
RELAY_PORT=5320
RELAY_PATH=/hub
MAX_SLAVE_CONNECTIONS=64
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10
CLOUD_SSL_VERIFY=true

# Retry settings
RETRY_BASE_SECONDS=1
RETRY_MAX_SECONDS=60
RETRY_JITTER_RATIO=0.30

# Slave fallback settings
WIFI_INTERFACE=wlan0
CHECK_INTERVAL_SECONDS=5
WIFI_DOWN_THRESHOLD=3
WIFI_UP_STABLE_SECONDS=60
HUB_ENV_FILE=/opt/rpi-hub-server/.env
HUB_SERVICE_NAME=rpi-hub-server.service
MASTER_HOST_HINTS=
DISCOVERY_SUBNETS=192.168.1.0/24
DISCOVERY_WORKERS=64
MAX_SCAN_HOSTS_PER_SUBNET=512
DISCOVERY_CONNECT_TIMEOUT=1.5
DISCOVERY_READ_TIMEOUT=1.5
MASTER_HEALTH_CHECK_SECONDS=10
NMAP_BINARY=nmap
NMAP_SCAN_TIMEOUT_SECONDS=30
NMAP_HOST_TIMEOUT_SECONDS=2
NMAP_MAX_RETRIES=1
NMAP_TIMING_TEMPLATE=4
