# Uplink manager configuration: copy to /etc/hyperloop-uplink/config.env on the cellular hub.
# Setup guide: .claude/rpi-hub-setup.md (section "Cellular hub") in the hyperloop-gui repo.

LOG_LEVEL=INFO

# Interfaces (check with: nmcli device status)
WIFI_INTERFACE=wlan0
CELLULAR_INTERFACE=wwan0
# NetworkManager connection name for the cellular HAT (nmcli connection show).
# Leave empty on a hub without cellular.
CELLULAR_CONNECTION=cellular

# Reachability probes: TCP connects forced through each interface. Any success = link usable.
PROBE_TARGETS=api.cornellhyperloop.com:443,1.1.1.1:443
PROBE_TIMEOUT_SECONDS=3

# Policy
CHECK_INTERVAL_SECONDS=5
# Consecutive failed Wi-Fi probes before switching to cellular
WIFI_DOWN_THRESHOLD=3
# Wi-Fi must probe good this long before switching back from cellular
WIFI_UP_STABLE_SECONDS=60

# Routing (lower metric wins)
PREFERRED_ROUTE_METRIC=100
FALLBACK_ROUTE_METRIC=700
# Keep the cellular connection up while on Wi-Fi (faster failover, uses a little data)
CELLULAR_WARM_STANDBY=true

# Read by rpi-hub-server (uplink.status_file)
STATUS_FILE=/run/hyperloop-uplink/status.json

# Log routing commands instead of running them
DRY_RUN=false
